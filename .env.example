LOG_ANALYZER_APP_NAME=Log Analyzer
LOG_ANALYZER_HOST=0.0.0.0
LOG_ANALYZER_PORT=8080
# Copy this file to private/.env for LOCAL execution; never put real credentials here.
# Local default database: private/data/log-analyzer.db
# Docker Compose explicitly uses its existing named volume instead.
# LOG_ANALYZER_DATABASE_URL=sqlite:////app/data/log-analyzer.db
# LOG_ANALYZER_FRONTEND_DIR=/app/frontend
# Saved by the settings UI into private/.env. Leave this public example empty.
# Do not copy empty placeholders over an existing private/.env during upgrades.
# LLM_API_KEY=
# GMAIL_SENDER=
# GMAIL_RECIPIENT=
# GMAIL_APP_PASSWORD=
# JWT_SECRET=
